DATABASE_URL=postgresql://spt_runtime:spt_runtime_local@localhost:55432/spt?schema=public
MIGRATION_DATABASE_URL=postgresql://spt:spt_local@localhost:55432/spt?schema=public
PORT=3000
# Optional API pool tuning. Defaults: 20 connections, 5000 ms waiting for one, 5000 ms waiting for a row lock.
DATABASE_POOL_MAX=
DATABASE_POOL_MAX_WAIT_MS=
DATABASE_LOCK_TIMEOUT_MS=
# Generate a private value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Separate encryption key, generated as 32 random bytes in hex; retain it to decrypt MFA secrets.
MFA_ENCRYPTION_KEY=

# Local testing only. Production refuses to start when bypass is enabled.
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=
DEV_AUTH_TENANT_ID=
# Private local password for MFA confirmation on the test account; generated by dev:setup.
DEV_AUTH_TEST_PASSWORD=

# Private S3-compatible storage. Use restricted credentials in production.
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=spt-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Separate worker role: execute queue functions only, no table ownership or RLS bypass.
WORKER_DATABASE_URL=


# Google Maps Embed API browser key; restrict API and allowed websites.
GOOGLE_MAPS_API_KEY=

# Free INPE CBERS-4A imagery for preview and new PDFs; no API key required.
INPE_MAP_ENABLED=true

# Reverse proxies in front of the API. Local: 0. compose.production.yaml defaults to 2 (external TLS proxy + nginx).
TRUST_PROXY_HOPS=0
